# Optional MacWhisper Automation config.
# Copy to: ~/.config/macwhisper-automation/config.env
# Any line you uncomment below becomes the default for transcribe_call.zsh runs.

# Force a specific MacWhisper model (engine:model-id). Run `mw models list` to see options.
# MW_MODEL=apple:en-US

# Reserved for future language-code overrides.
# MW_LANG=en
